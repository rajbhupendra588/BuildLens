# --- APP CONFIG ---
APP_NAME=BuildLens
ENVIRONMENT=development

# Browser → API (host machine). Use localhost when UI is at http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Session cookies (HttpOnly). Production: ENVIRONMENT=production, AUTH__COOKIE_SECURE=true, HTTPS.
# CORS origins must be exact UI origins — credentialed cookies cannot use *.
AUTH__COOKIE_NAME=buildlens_session
AUTH__COOKIE_SECURE=false
AUTH__SESSION_TTL_SECONDS=604800
AUTH__PUBLIC_APP_URL=http://localhost:3000
AUTH__CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Embedding model cache (Docker: persisted in backend_model_cache volume)
# FASTEMBED_CACHE_DIR=/app/.cache/fastembed

# --- POSTGRESQL DATABASE SETTING ---
# Used by the postgres Docker image
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=buildlens_db
# Used by pydantic-settings (DB nested model via __ delimiter)
DB__USER=postgres
DB__PASSWORD=password
DB__NAME=buildlens_db
DB__HOST=postgres
DB__PORT=5432

# --- VECTOR DATABASE ---
# Match the Settings.QDRANT structure
QDRANT__HOST=qdrant
QDRANT__PORT=6333
QDRANT__COLLECTION_NAME=knowledge_base

# --- FILE STORAGE (original uploads for image preview in chat) ---
STORAGE__UPLOAD_DIR=uploads_data
STORAGE__REPORTS_DIR=reports_data
STORAGE__MAX_UPLOAD_BYTES=20971520
STORAGE__MAX_LIBRARY_FILES=5
STORAGE__MAX_SESSION_ATTACHMENTS=5
STORAGE__UPLOAD_STREAM_CHUNK_BYTES=16777216

# Ingest memory (Docker 8GiB backend): long tabular chunks auto-use smaller embed batches.
INGEST__EMBED_BATCH_SIZE=8
INGEST__CHUNK_YIELD_BATCH_SIZE=32
INGEST__PRELOAD_EMBED_MODEL=true
# Optional per-file chunk ceiling (0 = unlimited). Only set if you need a hard safety cap.
# INGEST__MAX_INDEX_CHUNKS=50000
# INGEST__TABULAR_CHUNK_TARGET_CHARS=4000
# Ingest master: spawns worker threads at runtime (max 5) to index uploads_data.
INGEST__ENABLE_WORKER_POOL=true
INGEST__WORKER_POLL_SECONDS=2
INGEST__WORKER_MAX_PARALLEL=5
# Override auto plan (1-5), or 0 to disable workers:
# INGEST__WORKER_COUNT=3
# Match Docker mem_limit (GiB) so production plan does not oversubscribe OCR/embed:
INGEST__WORKER_MEMORY_BUDGET_GB=8
# ENVIRONMENT=production → more parallel workers (still capped at 5)

# --- AI PROVIDERS ---
# Match the Settings.LLM structure
LLM__PROVIDER=ollama
LLM__OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM__OPENAI_API_KEY=your_key_here
LLM__ANTHROPIC_API_KEY=your_key_here
LLM__GEMINI_API_KEY=your_key_here