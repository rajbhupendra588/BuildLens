# --- APP CONFIG ---
APP_NAME=BuildLens
ENVIRONMENT=development

# Browser → API (host machine). Use localhost when UI is at http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Embedding model cache (Docker: persisted in backend_model_cache volume)
# FASTEMBED_CACHE_DIR=/app/.cache/fastembed

# --- POSTGRESQL DATABASE SETTING ---
# Used by the postgres Docker image
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=buildlens_db
# Used by pydantic-settings (DB nested model via __ delimiter)
DB__USER=postgres
DB__PASSWORD=password
DB__NAME=buildlens_db
DB__HOST=postgres
DB__PORT=5432

# --- VECTOR DATABASE ---
# Match the Settings.QDRANT structure
QDRANT__HOST=qdrant
QDRANT__PORT=6333
QDRANT__COLLECTION_NAME=knowledge_base

# --- FILE STORAGE (original uploads for image preview in chat) ---
STORAGE__UPLOAD_DIR=uploads_data
STORAGE__MAX_UPLOAD_BYTES=20971520
STORAGE__MAX_LIBRARY_FILES=5
STORAGE__MAX_SESSION_ATTACHMENTS=5

# --- AI PROVIDERS ---
# Match the Settings.LLM structure
LLM__PROVIDER=ollama
LLM__OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM__OPENAI_API_KEY=your_key_here
LLM__ANTHROPIC_API_KEY=your_key_here
LLM__GEMINI_API_KEY=your_key_here